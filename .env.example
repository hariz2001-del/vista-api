# Local development. Matches docker-compose.yml, which reads POSTGRES_PASSWORD
# from this file when it starts the database container. The same password
# appears in both URLs: Prisma queries through DATABASE_URL and migrates through
# DIRECT_URL — locally they are the same database; on Supabase they are the
# transaction and session poolers (see .env.production.example).
#
# Port 5433, so this copy's database can run beside the ec2 copy's on 5432.
POSTGRES_PASSWORD=choose-a-local-password
DATABASE_URL="postgresql://vista:choose-a-local-password@127.0.0.1:5433/vista?schema=public"
DIRECT_URL="postgresql://vista:choose-a-local-password@127.0.0.1:5433/vista?schema=public"

# Sign key for cashier/owner sessions. Generate a real one for anything but local:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="local-development-secret-do-not-use-in-production-000000"

PORT=3000
NODE_ENV=development

# Sites whose pages may call the API from a browser. Defaults to the local dev
# servers when unset. Production: https://pos.vistahub.my,https://rms.vistahub.my
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# The account's first password and counter PIN, applied by `npm run seed`.
# Choose your own — these are not credentials, just the names of the settings.
SEED_PASSWORD=choose-a-local-password
SEED_PIN=0000
