# Local development. Matches docker-compose.yml, which reads POSTGRES_PASSWORD
# from this file when it starts the database container. The same password
# appears twice: once for the container, once in the URL Prisma connects with.
POSTGRES_PASSWORD=vista_local_dev
DATABASE_URL="postgresql://vista:vista_local_dev@127.0.0.1:5432/vista?schema=public"

# Sign key for cashier/owner sessions. Generate a real one for anything but local:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="local-development-secret-do-not-use-in-production-000000"

PORT=3000
NODE_ENV=development

# Sites whose pages may call the API from a browser. Defaults to the local dev
# servers when unset. Production: https://pos.vistahub.my,https://rms.vistahub.my
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174
