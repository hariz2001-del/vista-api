// Vista — money-path schema.
//
// Rules that hold across this whole file:
//
//  * Every monetary column is an integer number of sen. No floats, no numeric.
//    RM 14.50 is 1450. This is the one representation that stays exact through
//    Postgres, JSON and JavaScript alike.
//  * Rows on orders, order_items and order_item_modifiers are SNAPSHOTS. They
//    are written once at checkout and never updated, so editing the catalogue
//    later cannot rewrite what an old sale reported.
//  * `brandId` being null means "shared", rather than a SHARED enum member.
//    A brand is a real row; sharedness is the absence of one.
//  * Every row belongs to one business, and a row can only point at rows of the
//    same business. Relations between business-owned tables are COMPOSITE
//    foreign keys — `(business_id, x_id) → x(business_id, id)` — so a sale can
//    never reference another business's product, shift or brand, even if the
//    API has a bug. The API scopes every query too (src/db.ts); the keys are the
//    backstop. A relation that is optional must be `onDelete: Restrict`: the
//    default, SetNull, would try to null `business_id` along with the id.
//
// Prisma Migrate owns this schema. Never hand-apply DDL to the database — the
// predecessor project kept a Prisma schema as documentation alongside manual
// SQL and the two silently drifted apart.

// On Supabase the two URLs are different doors into the same database:
//  * DATABASE_URL — the transaction pooler (port 6543). The API's queries go
//    through it, because serverless functions open connections by the dozen.
//  * DIRECT_URL — the session pooler (port 5432). Prisma Migrate needs a real
//    session, which the transaction pooler cannot give it.
// Locally both point at the same Docker database.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  // "native" for this machine; rhel-openssl-3.0.x is what Vercel's functions run.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER_FOOD
  OWNER_DRINKS
  CASHIER
  /// The business account. Each business has one account that signs in to both
  /// apps; what a session can reach is decided by its scope, not by this.
  OWNER
}

enum ModifierType {
  ADD_ON
  REMOVAL
}

enum ShiftStatus {
  OPEN
  CLOSED
}

/// Set at close. A non-zero variance leaves the shift UNRECONCILED until the
/// owner declares what it was from the RMS — that action writes the ledger
/// entry, not the close itself.
enum ReconciliationStatus {
  NOT_REQUIRED
  UNRECONCILED
  RECONCILED
}

enum OrderPaymentStatus {
  MANUALLY_CONFIRMED
  REFUNDED
}

/// Whether the device was online when the sale was rung up. Decides whether a
/// total that disagrees with the catalogue is an error or an expected
/// consequence of pricing from a cached menu.
enum OrderOrigin {
  ONLINE
  OFFLINE_SYNC
}

enum CorrectionKind {
  CANCEL
  EXCHANGE
}

/// Raised by the cashier, resolved by the owner. Cashiers cannot void a paid
/// sale; flagging is the only thing they can do to one.
enum FlagStatus {
  NONE
  FLAGGED
  DISMISSED
  RESOLVED_REFUND
  RESOLVED_ADJUSTMENT
}

enum LedgerDirection {
  MONEY_IN
  MONEY_OUT
}

enum LedgerCategory {
  REVENUE
  REFUND
  OPERATING_EXPENSE
  CAPITAL_INJECTION
  CAPITAL_ASSET
  OWNER_DRAWING
  LOAN_PROCEEDS
  LOAN_REPAYMENT
  RECONCILIATION_ADJUSTMENT
}

// ---------------------------------------------------------------------------
// Businesses
// ---------------------------------------------------------------------------

/// One registered business: its own account, menu, sales and books. Nothing
/// in one business is visible to another.
model Business {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  users          User[]
  brands         Brand[]
  shifts         Shift[]
  queueCounters  QueueCounter[]
  ledgerEntries  LedgerEntry[]
  settings       AccountSettings?
  terminalStatus TerminalStatus?
  handoffCodes   HandoffCode[]
  promotions     Promotion[]

  @@map("businesses")
}

// ---------------------------------------------------------------------------
// Promotions
// ---------------------------------------------------------------------------

enum PromotionKind {
  /// `value` is a percentage, 1–100, of whatever it is applied to.
  PERCENT
  /// `value` is sen off, never more than what it is applied to.
  AMOUNT
}

/// What a promo takes its discount off.
enum PromotionScope {
  /// The whole order. Picked by the cashier, or applied to every order automatically.
  ORDER
  /// Any item that matches one of its targets. Applied automatically.
  ITEMS
  /// A set of items bought together — every target, in its quantity. Applied automatically.
  COMBO
}

/// How often an automatic promo applies within one order.
enum PromotionLimit {
  /// Every matching item, or every complete combo.
  EACH
  /// At most once per receipt.
  ONCE_PER_ORDER
}

/// A promo the owner sets up — "Merdeka 10%", "RM 2 off Kopi", "Nasi Lemak +
/// Drink combo". It runs on business dates inside its range.
/// A whole-order promo is either picked by the cashier from the discount screen
/// or applied to every order automatically. Item and combo promos apply
/// themselves when the order contains what they target. Either way the counter
/// works the amounts out and the cashier can take an automatic one off.
/// What is recorded on the sale is the discount itself, checked by the server
/// like any other, so editing or deleting a promo never changes a past sale.
model Promotion {
  id         String         @id @default(uuid())
  businessId String         @map("business_id")
  name       String
  kind       PromotionKind
  value      Int
  scope      PromotionScope @default(ORDER)
  /// Whole-order promos only: applied without the cashier picking it. Item and combo promos always are.
  autoApply  Boolean        @default(false) @map("auto_apply")
  limit      PromotionLimit @default(EACH)
  /// First business date it runs on.
  startsOn   DateTime       @map("starts_on") @db.Date
  /// Last business date it runs on, inclusive. Null runs until switched off.
  endsOn     DateTime?      @map("ends_on") @db.Date
  isActive   Boolean        @default(true) @map("is_active")
  sortOrder  Int            @default(0) @map("sort_order")
  createdAt  DateTime       @default(now()) @map("created_at")

  business Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  targets  PromotionTarget[]

  @@unique([businessId, id])
  @@index([businessId, startsOn])
  @@map("promotions")
}

/// What an item or combo promo applies to: one product or a whole category.
/// For a combo, `quantity` is how many of it the combo needs.
model PromotionTarget {
  id          String  @id @default(uuid())
  businessId  String  @map("business_id")
  promotionId String  @map("promotion_id")
  productId   String? @map("product_id")
  categoryId  String? @map("category_id")
  quantity    Int     @default(1)
  sortOrder   Int     @default(0) @map("sort_order")

  promotion Promotion @relation(fields: [businessId, promotionId], references: [businessId, id], onDelete: Cascade)
  product   Product?  @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Cascade)
  category  Category? @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Cascade)

  @@index([promotionId])
  @@map("promotion_targets")
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  businessId   String   @map("business_id")
  /// Unique across every business: the email is how a sign-in finds its business.
  email        String   @unique
  passwordHash String   @map("password_hash")
  /// Bcrypt hash of the 4-digit shift PIN. Never sent to a client.
  pinHash      String?  @map("pin_hash")
  name         String
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  business           Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  shiftsOpened       Shift[]          @relation("ShiftsOpened")
  shiftsClosed       Shift[]          @relation("ShiftsClosed")
  ordersConfirmed    Order[]          @relation("OrdersConfirmed")
  correctionsCreated SaleCorrection[] @relation("CorrectionsCreated")
  expensesCreated    Expense[]        @relation("ExpensesCreated")
  periodsClosed      PeriodClosure[]  @relation("PeriodsClosed")
  sessions           Session[]
  handoffCodes       HandoffCode[]

  @@unique([businessId, id])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

/// Brand is a financial dimension, not a label: partner profit share and
/// overhead allocation both key off it. It is a table so that a rename or a
/// third brand is never a code change.
model Brand {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  name       String
  colour     String
  softColour String   @map("soft_colour")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  business         Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  categories       Category[]
  products         Product[]
  orderItems       OrderItem[]
  ledgerEntries    LedgerEntry[]
  correctionDeltas CorrectionBrandDelta[]
  expenses         Expense[]
  partner          Partner?

  @@unique([businessId, id])
  @@unique([businessId, name])
  @@map("brands")
}

model Category {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  brandId    String   @map("brand_id")
  name       String
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  brand            Brand             @relation(fields: [businessId, brandId], references: [businessId, id], onDelete: Restrict)
  products         Product[]
  orderItems       OrderItem[]
  promotionTargets PromotionTarget[]

  @@unique([businessId, id])
  @@unique([brandId, name])
  @@map("categories")
}

model Product {
  id           String   @id @default(uuid())
  businessId   String   @map("business_id")
  brandId      String   @map("brand_id")
  categoryId   String   @map("category_id")
  name         String
  description  String   @default("")
  basePriceSen Int      @map("base_price_sen")
  imageUrl     String?  @map("image_url")
  isSoldOut    Boolean  @default(false) @map("is_sold_out")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  brand            Brand             @relation(fields: [businessId, brandId], references: [businessId, id], onDelete: Restrict)
  category         Category          @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict)
  modifierGroups   ModifierGroup[]
  orderItems       OrderItem[]
  promotionTargets PromotionTarget[]

  @@unique([businessId, id])
  @@index([brandId])
  @@index([categoryId])
  @@map("products")
}

model ModifierGroup {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  productId   String   @map("product_id")
  name        String
  description String?
  /// minSelect > 0 means required. There is deliberately no separate
  /// `isRequired` flag: two sources of truth eventually disagree.
  minSelect   Int      @default(0) @map("min_select")
  maxSelect   Int      @default(1) @map("max_select")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  product Product        @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Cascade)
  items   ModifierItem[]

  @@unique([businessId, id])
  @@index([productId])
  @@map("modifier_groups")
}

model ModifierItem {
  id              String       @id @default(uuid())
  businessId      String       @map("business_id")
  modifierGroupId String       @map("modifier_group_id")
  name            String
  priceSen        Int          @default(0) @map("price_sen")
  type            ModifierType @default(ADD_ON)
  isSoldOut       Boolean      @default(false) @map("is_sold_out")
  sortOrder       Int          @default(0) @map("sort_order")
  createdAt       DateTime     @default(now()) @map("created_at")

  group              ModifierGroup       @relation(fields: [businessId, modifierGroupId], references: [businessId, id], onDelete: Cascade)
  orderItemModifiers OrderItemModifier[]

  @@unique([businessId, id])
  @@index([modifierGroupId])
  @@map("modifier_items")
}

// ---------------------------------------------------------------------------
// Shifts
// ---------------------------------------------------------------------------

model Shift {
  id           String      @id @default(uuid())
  businessId   String      @map("business_id")
  /// The trading evening this shift belongs to. A shift opened at 8pm and still
  /// running at 1am keeps the date it opened on, so a post-midnight sale reports
  /// against the night it was actually made.
  businessDate DateTime    @map("business_date") @db.Date
  status       ShiftStatus @default(OPEN)
  openedAt     DateTime    @default(now()) @map("opened_at")
  closedAt     DateTime?   @map("closed_at")
  openedById   String      @map("opened_by_id")
  closedById   String?     @map("closed_by_id")

  /// What the cashier says the bank actually received, entered at close.
  declaredBankTotalSen Int? @map("declared_bank_total_sen")
  /// Net MONEY_IN revenue less MONEY_OUT refunds for this shift, computed
  /// server-side at close and updated when an offline record arrives late.
  systemNetSalesSen    Int? @map("system_net_sales_sen")
  /// declared − system. Positive is a surplus, negative a shortfall.
  varianceSen          Int? @map("variance_sen")

  reconciliationStatus ReconciliationStatus @default(NOT_REQUIRED) @map("reconciliation_status")

  business      Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  openedBy      User             @relation("ShiftsOpened", fields: [businessId, openedById], references: [businessId, id], onDelete: Restrict)
  closedBy      User?            @relation("ShiftsClosed", fields: [businessId, closedById], references: [businessId, id], onDelete: Restrict)
  orders        Order[]
  ledgerEntries LedgerEntry[]
  corrections   SaleCorrection[]

  @@unique([businessId, id])
  @@index([businessId, businessDate])
  @@index([businessId, status])
  @@map("shifts")
}

/// One row per business per trading day. The queue number resets daily and is
/// allocated by `UPDATE … RETURNING`, which takes the row lock itself — so
/// there is no read-then-increment gap for two terminals to fall into.
model QueueCounter {
  businessId   String   @map("business_id")
  businessDate DateTime @map("business_date") @db.Date
  currentVal   Int      @default(0) @map("current_val")
  updatedAt    DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@id([businessId, businessDate])
  @@map("queue_counters")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id           String   @id @default(uuid())
  businessId   String   @map("business_id")
  shiftId      String   @map("shift_id")
  businessDate DateTime @map("business_date") @db.Date

  /// `#042`. Unique within a business and business date.
  queueNumber  String  @map("queue_number")
  /// The `#OFF-01` the kitchen was actually told, when this sale was rung up
  /// offline. Kept after syncing: it is the only way to trace a disputed order
  /// back to what the customer was called.
  offlineLabel String? @map("offline_label")

  /// Minted on the device once per checkout and reused across every retry.
  /// The unique constraint is what makes replaying an offline sale safe.
  clientTxnId String      @unique @map("client_txn_id")
  origin      OrderOrigin @default(ONLINE)

  /// Server-recomputed. grossSen − orderDiscountSen − sum(line discounts) = totalAmountSen.
  grossSen         Int @map("gross_sen")
  lineDiscountSen  Int @default(0) @map("line_discount_sen")
  orderDiscountSen Int @default(0) @map("order_discount_sen")
  /// What the customer actually paid. For an offline sale this is the figure the
  /// device charged, which is the money that moved; it is never overwritten with
  /// a later menu price.
  totalAmountSen   Int @map("total_amount_sen")
  /// What the same basket comes to at the catalogue prices in force when the
  /// sale reached the server. Equal to `totalAmountSen` except for an offline
  /// sale priced against a menu that has since moved — the divergence is kept so
  /// it can be reported on rather than silently trusted or silently discarded.
  menuPriceSen     Int @map("menu_price_sen")

  paymentStatus OrderPaymentStatus @default(MANUALLY_CONFIRMED) @map("payment_status")
  paymentMode   String             @default("DUITNOW_QR") @map("payment_mode")

  /// Manual confirmation is the only control on revenue — there is no payment
  /// gateway — so who did it and when is recorded, once, and never edited.
  confirmedById String   @map("confirmed_by_id")
  confirmedAt   DateTime @map("confirmed_at")

  /// Raised by the cashier for the owner to resolve.
  flagStatus FlagStatus @default(NONE) @map("flag_status")
  flagReason String?    @map("flag_reason")

  /// Raised by the server, not the cashier — e.g. an offline sale whose price
  /// no longer matches the catalogue. Accepted, never silently repriced.
  needsReview  Boolean @default(false) @map("needs_review")
  reviewReason String? @map("review_reason")

  /// Set once the containing month has been closed and settled.
  isLocked Boolean @default(false) @map("is_locked")

  completedAt DateTime @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  shift         Shift            @relation(fields: [businessId, shiftId], references: [businessId, id], onDelete: Restrict)
  confirmedBy   User             @relation("OrdersConfirmed", fields: [businessId, confirmedById], references: [businessId, id], onDelete: Restrict)
  items         OrderItem[]
  ledgerEntries LedgerEntry[]
  corrections   SaleCorrection[]

  @@unique([businessId, id])
  @@unique([businessId, businessDate, queueNumber])
  @@index([shiftId])
  @@index([businessId, businessDate])
  @@index([needsReview])
  @@map("orders")
}

// ---------------------------------------------------------------------------
// Paid-sale corrections
// ---------------------------------------------------------------------------

/// Append-only counter correction. The paid order remains untouched; this row
/// and its brand deltas describe the value that moved afterwards.
model SaleCorrection {
  id                         String         @id @default(uuid())
  businessId                 String         @map("business_id")
  clientTxnId                String         @unique @map("client_txn_id")
  originalOrderId            String         @map("original_order_id")
  shiftId                    String         @map("shift_id")
  businessDate               DateTime       @map("business_date") @db.Date
  kind                       CorrectionKind
  reason                     String
  /// Signed: negative is money returned; positive is additional money received.
  deltaSen                   Int            @map("delta_sen")
  /// Full server-resolved ticket after an exchange. Null for a cancellation.
  replacementItems           Json?          @map("replacement_items")
  replacementCartDiscountSen Int?           @map("replacement_cart_discount_sen")
  replacementTotalSen        Int?           @map("replacement_total_sen")
  replacementMenuPriceSen    Int?           @map("replacement_menu_price_sen")
  createdById                String         @map("created_by_id")
  createdAt                  DateTime       @default(now()) @map("created_at")

  originalOrder Order                  @relation(fields: [businessId, originalOrderId], references: [businessId, id], onDelete: Restrict)
  shift         Shift                  @relation(fields: [businessId, shiftId], references: [businessId, id], onDelete: Restrict)
  createdBy     User                   @relation("CorrectionsCreated", fields: [businessId, createdById], references: [businessId, id], onDelete: Restrict)
  brandDeltas   CorrectionBrandDelta[]
  ledgerEntries LedgerEntry[]

  @@unique([businessId, id])
  @@index([originalOrderId, createdAt])
  @@index([shiftId])
  @@index([businessId, businessDate])
  @@map("sale_corrections")
}

/// Signed per-brand component of a correction. Kept as rows because settlement
/// and the ledger both report by brand, and JSON would make those sums fragile.
model CorrectionBrandDelta {
  id           BigInt @id @default(autoincrement())
  businessId   String @map("business_id")
  correctionId String @map("correction_id")
  brandId      String @map("brand_id")
  deltaSen     Int    @map("delta_sen")

  correction SaleCorrection @relation(fields: [businessId, correctionId], references: [businessId, id], onDelete: Cascade)
  brand      Brand          @relation(fields: [businessId, brandId], references: [businessId, id], onDelete: Restrict)

  @@unique([correctionId, brandId])
  @@index([brandId])
  @@map("correction_brand_deltas")
}

model OrderItem {
  id         String @id @default(uuid())
  businessId String @map("business_id")
  orderId    String @map("order_id")

  /// Restrict, not Cascade: a product that has ever been sold cannot be deleted,
  /// only deactivated. Historical lines must keep pointing somewhere real.
  productId  String @map("product_id")
  brandId    String @map("brand_id")
  categoryId String @map("category_id")

  /// Snapshot of the name as printed, in case the product is later renamed.
  productName String @map("product_name")

  quantity         Int @default(1)
  unitPriceSen     Int @map("unit_price_sen")
  modifierTotalSen Int @default(0) @map("modifier_total_sen")

  /// A discount applied to this line specifically.
  lineDiscountSen           Int @default(0) @map("line_discount_sen")
  /// This line's share of the order-wide discount, apportioned server-side by
  /// largest remainder. Stored rather than recomputed at report time, so
  /// per-brand net sales is a plain SUM and can never drift.
  allocatedOrderDiscountSen Int @default(0) @map("allocated_order_discount_sen")

  order     Order               @relation(fields: [businessId, orderId], references: [businessId, id], onDelete: Cascade)
  product   Product             @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)
  brand     Brand               @relation(fields: [businessId, brandId], references: [businessId, id], onDelete: Restrict)
  category  Category            @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict)
  modifiers OrderItemModifier[]

  @@unique([businessId, id])
  @@index([orderId])
  @@index([brandId])
  @@map("order_items")
}

/// Rows, not a JSON blob: add-on revenue by brand is a real report, and a blob
/// makes it a scan-and-parse.
model OrderItemModifier {
  id          String @id @default(uuid())
  businessId  String @map("business_id")
  orderItemId String @map("order_item_id")

  /// Nullable so a modifier deleted from the catalogue does not orphan the
  /// historical line. The snapshotted name and price stand on their own.
  ///
  /// The one relation here that is NOT composite: deleting the modifier nulls
  /// this column, and a composite key would null `business_id` with it. Checkout
  /// only ever resolves modifiers through the business-scoped client.
  modifierItemId String? @map("modifier_item_id")

  name     String
  priceSen Int          @default(0) @map("price_sen")
  type     ModifierType @default(ADD_ON)

  orderItem    OrderItem     @relation(fields: [businessId, orderItemId], references: [businessId, id], onDelete: Cascade)
  modifierItem ModifierItem? @relation(fields: [modifierItemId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

// ---------------------------------------------------------------------------
// Ledger
// ---------------------------------------------------------------------------

/// Append-only. Money is never corrected by editing an entry — a correction is
/// its own reversing entry, so the history stays auditable.
///
/// The running balance is computed, never stored, and must be ordered by
/// (businessDate, id) rather than id alone: entries get backdated, and ordering
/// by insertion would put a receipt entered on the 8th for the 3rd at the
/// bottom of the book with a meaningless balance beside it.
model LedgerEntry {
  id           BigInt   @id @default(autoincrement())
  businessId   String   @map("business_id")
  businessDate DateTime @map("business_date") @db.Date
  entryAt      DateTime @default(now()) @map("entry_at")

  direction   LedgerDirection
  amountSen   Int             @map("amount_sen")
  category    LedgerCategory
  description String

  /// Null means the entry is shared across brands rather than belonging to one.
  brandId String? @map("brand_id")

  orderId      String? @map("order_id")
  /// Set on entries produced by resolving a shift's unreconciled variance, so
  /// the owner can trace any adjustment back to the close that caused it.
  shiftId      String? @map("shift_id")
  correctionId String? @map("correction_id")

  createdAt DateTime @default(now()) @map("created_at")

  business   Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  brand      Brand?          @relation(fields: [businessId, brandId], references: [businessId, id], onDelete: Restrict)
  order      Order?          @relation(fields: [businessId, orderId], references: [businessId, id], onDelete: Restrict)
  shift      Shift?          @relation(fields: [businessId, shiftId], references: [businessId, id], onDelete: Restrict)
  correction SaleCorrection? @relation(fields: [businessId, correctionId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, businessDate, id])
  @@index([orderId])
  @@index([shiftId])
  @@index([correctionId])
  @@map("ledger_entries")
}

// ---------------------------------------------------------------------------
// Account
// ---------------------------------------------------------------------------

/// A business's profile and partner split. One row per business.
///
/// The percentages are read at the moment they are used — each expense
/// snapshots its own split when it is logged — so changing them here never
/// rewrites a past period.
model AccountSettings {
  businessId            String   @id @map("business_id")
  businessName          String   @map("business_name")
  outletName            String   @map("outlet_name")
  /// Partner settlement: two brands, each owned by a partner, with a monthly
  /// payout between them. Off for a new business; a solo shop never sees it.
  settlementEnabled     Boolean  @default(false) @map("settlement_enabled")
  /// When one trading day ends and the next begins, 0–12 (hour of the morning,
  /// Malaysia time). A 1am sale with the default 5 counts for the night before.
  dayRolloverHour       Int      @default(5) @map("day_rollover_hour")
  /// Share of shared overheads borne by Food, 0–100. Drinks takes the rest.
  sharedOverheadFoodPct Int      @map("shared_overhead_food_pct")
  /// The host's cut of the Food net result, 0–100.
  hostCommissionPct     Int      @map("host_commission_pct")
  /// Food's share of shared equipment, 0–100. Separate from the overhead split.
  capitalAssetFoodPct   Int      @map("capital_asset_food_pct")
  updatedAt             DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@map("account_settings")
}

// ---------------------------------------------------------------------------
// Owner books — expenses, settled periods, and the counter's heartbeat
// ---------------------------------------------------------------------------

enum ExpenseCategory {
  RAW_MATERIALS
  PACKAGING
  RENT
  UTILITIES
  OPERATIONS
  MAINTENANCE
  CAPITAL_ASSET
}

/// Who actually paid. A partner paying out of pocket creates a debt to them,
/// not an outflow from the stall — nothing reaches the ledger until the stall
/// reimburses them.
enum PaymentSource {
  STALL_FUNDS
  PARTNER_FOOD
  PARTNER_DRINKS
}

/// A cost the stall incurred.
///
/// The food/drinks split is a SNAPSHOT taken when the expense is logged, so a
/// later change to the overhead ratio can never rewrite a past period. CHECK
/// constraints in the migration make the two shares always sum to the amount.
/// With settlement off, the whole amount sits on the "food" side: the split is
/// only ever read by settlement.
model Expense {
  id              String          @id @default(uuid())
  businessId      String          @map("business_id")
  businessDate    DateTime        @map("business_date") @db.Date
  amountSen       Int             @map("amount_sen")
  category        ExpenseCategory
  paidBy          PaymentSource   @map("paid_by")
  /// Null means shared between brands, apportioned by the split below.
  brandId         String?         @map("brand_id")
  foodSplitPct    Int             @map("food_split_pct")
  foodAmountSen   Int             @map("food_amount_sen")
  drinksAmountSen Int             @map("drinks_amount_sen")
  description     String
  receiptUrl      String?         @map("receipt_url")
  /// For a partner-paid expense: has the stall reimbursed them yet?
  isSettled       Boolean         @default(false) @map("is_settled")
  /// Set once the containing period has been closed and settled.
  isLocked        Boolean         @default(false) @map("is_locked")
  createdById     String          @map("created_by_id")
  createdAt       DateTime        @default(now()) @map("created_at")

  brand     Brand? @relation(fields: [businessId, brandId], references: [businessId, id], onDelete: Restrict)
  createdBy User   @relation("ExpensesCreated", fields: [businessId, createdById], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, businessDate])
  @@index([paidBy, isSettled])
  @@map("expenses")
}

/// A settled period, frozen at the figures both partners were paid against.
///
/// Never recomputed. The next period's opening deficit is read from here, so
/// a locked month stays exactly as agreed. An exclusion constraint in the
/// migration makes two settled periods of one business overlapping impossible.
model PeriodClosure {
  id                    String   @id @default(uuid())
  businessId            String   @map("business_id")
  startDate             DateTime @map("start_date") @db.Date
  endDate               DateTime @map("end_date") @db.Date
  closedAt              DateTime @default(now()) @map("closed_at")
  closedById            String   @map("closed_by_id")
  foodNetSalesSen       Int      @map("food_net_sales_sen")
  foodDirectExpensesSen Int      @map("food_direct_expenses_sen")
  foodOverheadShareSen  Int      @map("food_overhead_share_sen")
  foodNetResultSen      Int      @map("food_net_result_sen")
  openingIouSen         Int      @map("opening_iou_sen")
  hostCommissionSen     Int      @map("host_commission_sen")
  closingIouSen         Int      @map("closing_iou_sen")
  foodPayoutSen         Int      @map("food_payout_sen")
  drinksPayoutSen       Int      @map("drinks_payout_sen")

  closedBy User @relation("PeriodsClosed", fields: [businessId, closedById], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, endDate])
  @@map("period_closures")
}

/// What the owner can know about their counter tablet. One row per business.
///
/// Written only by the tablet's heartbeat. The server cannot see a tablet that
/// has stopped calling, so silence is the only offline signal there is.
model TerminalStatus {
  businessId              String    @id @map("business_id")
  lastSeenAt              DateTime? @map("last_seen_at")
  /// Flush attempts in a row that failed to send something, as the tablet reports.
  consecutiveSyncFailures Int       @default(0) @map("consecutive_sync_failures")
  lastSeenById            String?   @map("last_seen_by_id")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@map("terminal_status")
}

// ---------------------------------------------------------------------------
// Sessions and partners
// ---------------------------------------------------------------------------

/// What a session may reach. One account signs in to both apps; the scope is
/// decided by which app signed in.
enum SessionScope {
  /// The counter tablet: sales, corrections, shifts. Never expires — the
  /// cashier only ever has the PIN — and is revoked from the RMS instead.
  COUNTER
  /// The owner dashboard: everything, including the books. Expires.
  OWNER
  /// vistahub.my, between signing in and picking an app. Can do exactly one
  /// thing — mint a handoff code — and lasts minutes.
  HUB
}

/// One signed-in device. Every request checks its row, which is how signing
/// the counter out from the RMS takes effect on the tablet's very next request.
/// The business a request acts for is read from here, never from the request.
model Session {
  id         String       @id @default(uuid())
  businessId String       @map("business_id")
  userId     String       @map("user_id")
  scope      SessionScope
  createdAt  DateTime     @default(now()) @map("created_at")
  lastUsedAt DateTime     @default(now()) @map("last_used_at")
  revokedAt  DateTime?    @map("revoked_at")

  user User @relation(fields: [businessId, userId], references: [businessId, id], onDelete: Cascade)

  @@index([businessId, scope, revokedAt])
  @@map("sessions")
}

/// A one-time pass from vistahub.my to the POS or RMS. Each app keeps its own
/// sign-in on its own domain, so the hub cannot hand over a token directly; it
/// hands over this instead, which the app swaps for a session of its own.
///
/// Only the SHA-256 of the code is stored. It lives a minute and works once.
model HandoffCode {
  id         String       @id @default(uuid())
  businessId String       @map("business_id")
  userId     String       @map("user_id")
  codeHash   String       @unique @map("code_hash")
  /// COUNTER for the POS, OWNER for the RMS.
  target     SessionScope
  expiresAt  DateTime     @map("expires_at")
  usedAt     DateTime?    @map("used_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [businessId, userId], references: [businessId, id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("handoff_codes")
}

enum PartnerRole {
  FOOD_OWNER
  /// Hosts the stall and owns Drinks. Takes the host commission on Food.
  STALL_HOST
}

/// A partner in the business — a name settlement pays, one per brand. Not a
/// login: the business has one account.
model Partner {
  id         String      @id @default(uuid())
  businessId String      @map("business_id")
  name       String
  brandId    String      @map("brand_id")
  role       PartnerRole

  brand Brand @relation(fields: [businessId, brandId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, brandId])
  @@unique([businessId, role])
  @@map("partners")
}

// ---------------------------------------------------------------------------
// Guessing limits
// ---------------------------------------------------------------------------

/// Wrong-password and wrong-PIN attempts, one row per client per route. In the
/// database rather than memory because the API runs as serverless functions that
/// share no memory and are recycled at will (src/attempts.ts). A row is useless
/// once `resetAt` passes and is cleared on the next attempt.
model AttemptCounter {
  /// `<method> <route> <client address>`.
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(3)

  @@index([resetAt])
  @@map("attempt_counters")
}
