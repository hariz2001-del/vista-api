// Vista — money-path schema.
//
// Rules that hold across this whole file:
//
//  * Every monetary column is an integer number of sen. No floats, no numeric.
//    RM 14.50 is 1450. This is the one representation that stays exact through
//    Postgres, JSON and JavaScript alike.
//  * Rows on orders, order_items and order_item_modifiers are SNAPSHOTS. They
//    are written once at checkout and never updated, so editing the catalogue
//    later cannot rewrite what an old sale reported.
//  * `brandId` being null means "shared", rather than a SHARED enum member.
//    A brand is a real row; sharedness is the absence of one.
//  * Every row belongs to one business, and a row can only point at rows of the
//    same business. Relations between business-owned tables are COMPOSITE
//    foreign keys — `(business_id, x_id) → x(business_id, id)` — so a sale can
//    never reference another business's product, shift or brand, even if the
//    API has a bug. The API scopes every query too (src/db.ts); the keys are the
//    backstop. A relation that is optional must be `onDelete: Restrict`: the
//    default, SetNull, would try to null `business_id` along with the id.
//
// Prisma Migrate owns this schema. Never hand-apply DDL to the database — the
// predecessor project kept a Prisma schema as documentation alongside manual
// SQL and the two silently drifted apart.

// On Supabase the two URLs are different doors into the same database:
//  * DATABASE_URL — the transaction pooler (port 6543). The API's queries go
//    through it, because serverless functions open connections by the dozen.
//  * DIRECT_URL — the session pooler (port 5432). Prisma Migrate needs a real
//    session, which the transaction pooler cannot give it.
// Locally both point at the same Docker database.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  // "native" for this machine; rhel-openssl-3.0.x is what Vercel's functions run.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER_FOOD
  OWNER_DRINKS
  CASHIER
  /// The business account. Each business has one account that signs in to both
  /// apps; what a session can reach is decided by its scope, not by this.
  OWNER
}

enum ModifierType {
  ADD_ON
  REMOVAL
}

enum ShiftStatus {
  OPEN
  CLOSED
}

/// Set at close. A non-zero variance leaves the shift UNRECONCILED until the
/// owner declares what it was from the RMS — that action writes the ledger
/// entry, not the close itself.
enum ReconciliationStatus {
  NOT_REQUIRED
  UNRECONCILED
  RECONCILED
}

enum OrderPaymentStatus {
  MANUALLY_CONFIRMED
  REFUNDED
}

/// Whether the device was online when the sale was rung up. Decides whether a
/// total that disagrees with the catalogue is an error or an expected
/// consequence of pricing from a cached menu.
enum OrderOrigin {
  ONLINE
  OFFLINE_SYNC
}

enum CorrectionKind {
  CANCEL
  EXCHANGE
}

/// Raised by the cashier, resolved by the owner. Cashiers cannot void a paid
/// sale; flagging is the only thing they can do to one.
enum FlagStatus {
  NONE
  FLAGGED
  DISMISSED
  RESOLVED_REFUND
  RESOLVED_ADJUSTMENT
}

enum LedgerDirection {
  MONEY_IN
  MONEY_OUT
}

enum LedgerCategory {
  REVENUE
  REFUND
  OPERATING_EXPENSE
  CAPITAL_INJECTION
  CAPITAL_ASSET
  OWNER_DRAWING
  LOAN_PROCEEDS
  LOAN_REPAYMENT
  RECONCILIATION_ADJUSTMENT
}

// ---------------------------------------------------------------------------
// Businesses
// ---------------------------------------------------------------------------

/// One registered business: its own account, menu, sales and books. Nothing
/// in one business is visible to another.
model Business {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  users          User[]
  brands         Brand[]
  shifts         Shift[]
  queueCounters  QueueCounter[]
  ledgerEntries  LedgerEntry[]
  settings       AccountSettings?
  terminalStatus TerminalStatus?
  handoffCodes   HandoffCode[]
  promotions     Promotion[]
  staffMembers   StaffMember[]
  teamSettings   TeamSettings?
  rosterWeeks    RosterWeek[]
  teamAuditLog   TeamAuditEntry[]

  @@map("businesses")
}

// ---------------------------------------------------------------------------
// Promotions
// ---------------------------------------------------------------------------

enum PromotionKind {
  /// `value` is a percentage, 1–100, of whatever it is applied to.
  PERCENT
  /// `value` is sen off, never more than what it is applied to.
  AMOUNT
}

/// What a promo takes its discount off.
enum PromotionScope {
  /// The whole order. Picked by the cashier, or applied to every order automatically.
  ORDER
  /// Any item that matches one of its targets. Applied automatically.
  ITEMS
  /// A set of items bought together — every target, in its quantity. Applied automatically.
  COMBO
}

/// How often an automatic promo applies within one order.
enum PromotionLimit {
  /// Every matching item, or every complete combo.
  EACH
  /// At most once per receipt.
  ONCE_PER_ORDER
}

/// A promo the owner sets up — "Merdeka 10%", "RM 2 off Kopi", "Nasi Lemak +
/// Drink combo". It runs on business dates inside its range.
/// A whole-order promo is either picked by the cashier from the discount screen
/// or applied to every order automatically. Item and combo promos apply
/// themselves when the order contains what they target. Either way the counter
/// works the amounts out and the cashier can take an automatic one off.
/// What is recorded on the sale is the discount itself, checked by the server
/// like any other, so editing or deleting a promo never changes a past sale.
model Promotion {
  id         String         @id @default(uuid())
  businessId String         @map("business_id")
  name       String
  kind       PromotionKind
  value      Int
  scope      PromotionScope @default(ORDER)
  /// Whole-order promos only: applied without the cashier picking it. Item and combo promos always are.
  autoApply  Boolean        @default(false) @map("auto_apply")
  limit      PromotionLimit @default(EACH)
  /// First business date it runs on.
  startsOn   DateTime       @map("starts_on") @db.Date
  /// Last business date it runs on, inclusive. Null runs until switched off.
  endsOn     DateTime?      @map("ends_on") @db.Date
  isActive   Boolean        @default(true) @map("is_active")
  sortOrder  Int            @default(0) @map("sort_order")
  createdAt  DateTime       @default(now()) @map("created_at")

  business Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  targets  PromotionTarget[]

  @@unique([businessId, id])
  @@index([businessId, startsOn])
  @@map("promotions")
}

/// What an item or combo promo applies to: one product or a whole category.
/// For a combo, `quantity` is how many of it the combo needs.
model PromotionTarget {
  id          String  @id @default(uuid())
  businessId  String  @map("business_id")
  promotionId String  @map("promotion_id")
  productId   String? @map("product_id")
  categoryId  String? @map("category_id")
  quantity    Int     @default(1)
  sortOrder   Int     @default(0) @map("sort_order")

  promotion Promotion @relation(fields: [businessId, promotionId], references: [businessId, id], onDelete: Cascade)
  product   Product?  @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Cascade)
  category  Category? @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Cascade)

  @@index([promotionId])
  @@map("promotion_targets")
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  businessId   String   @map("business_id")
  /// Unique across every business: the email is how a sign-in finds its business.
  email        String   @unique
  passwordHash String   @map("password_hash")
  /// Bcrypt hash of the 4-digit shift PIN. Never sent to a client.
  pinHash      String?  @map("pin_hash")
  name         String
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  business           Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  shiftsOpened       Shift[]          @relation("ShiftsOpened")
  shiftsClosed       Shift[]          @relation("ShiftsClosed")
  ordersConfirmed    Order[]          @relation("OrdersConfirmed")
  correctionsCreated SaleCorrection[] @relation("CorrectionsCreated")
  expensesCreated    Expense[]        @relation("ExpensesCreated")
  periodsClosed      PeriodClosure[]  @relation("PeriodsClosed")
  sessions           Session[]
  handoffCodes       HandoffCode[]
  stockCounts        StockCount[]     @relation("StockCountsSubmitted")

  @@unique([businessId, id])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

/// Brand is a financial dimension, not a label: partner profit share and
/// overhead allocation both key off it. It is a table so that a rename or a
/// third brand is never a code change.
model Brand {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  name       String
  colour     String
  softColour String   @map("soft_colour")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  business         Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  categories       Category[]
  products         Product[]
  orderItems       OrderItem[]
  ledgerEntries    LedgerEntry[]
  correctionDeltas CorrectionBrandDelta[]
  expenses         Expense[]
  partner          Partner?
  stockItems       StockItem[]

  @@unique([businessId, id])
  @@unique([businessId, name])
  @@map("brands")
}

model Category {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  brandId    String   @map("brand_id")
  name       String
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  brand            Brand             @relation(fields: [businessId, brandId], references: [businessId, id], onDelete: Restrict)
  products         Product[]
  orderItems       OrderItem[]
  promotionTargets PromotionTarget[]

  @@unique([businessId, id])
  @@unique([brandId, name])
  @@map("categories")
}

model Product {
  id           String   @id @default(uuid())
  businessId   String   @map("business_id")
  brandId      String   @map("brand_id")
  categoryId   String   @map("category_id")
  name         String
  description  String   @default("")
  basePriceSen Int      @map("base_price_sen")
  imageUrl     String?  @map("image_url")
  isSoldOut    Boolean  @default(false) @map("is_sold_out")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  brand            Brand             @relation(fields: [businessId, brandId], references: [businessId, id], onDelete: Restrict)
  category         Category          @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict)
  modifierGroups   ModifierGroup[]
  orderItems       OrderItem[]
  promotionTargets PromotionTarget[]

  @@unique([businessId, id])
  @@index([brandId])
  @@index([categoryId])
  @@map("products")
}

model ModifierGroup {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  productId   String   @map("product_id")
  name        String
  description String?
  /// minSelect > 0 means required. There is deliberately no separate
  /// `isRequired` flag: two sources of truth eventually disagree.
  minSelect   Int      @default(0) @map("min_select")
  maxSelect   Int      @default(1) @map("max_select")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  product Product        @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Cascade)
  items   ModifierItem[]

  @@unique([businessId, id])
  @@index([productId])
  @@map("modifier_groups")
}

model ModifierItem {
  id              String       @id @default(uuid())
  businessId      String       @map("business_id")
  modifierGroupId String       @map("modifier_group_id")
  name            String
  priceSen        Int          @default(0) @map("price_sen")
  type            ModifierType @default(ADD_ON)
  isSoldOut       Boolean      @default(false) @map("is_sold_out")
  sortOrder       Int          @default(0) @map("sort_order")
  createdAt       DateTime     @default(now()) @map("created_at")

  group              ModifierGroup       @relation(fields: [businessId, modifierGroupId], references: [businessId, id], onDelete: Cascade)
  orderItemModifiers OrderItemModifier[]

  @@unique([businessId, id])
  @@index([modifierGroupId])
  @@map("modifier_items")
}

// ---------------------------------------------------------------------------
// Shifts
// ---------------------------------------------------------------------------

model Shift {
  id           String      @id @default(uuid())
  businessId   String      @map("business_id")
  /// The trading evening this shift belongs to. A shift opened at 8pm and still
  /// running at 1am keeps the date it opened on, so a post-midnight sale reports
  /// against the night it was actually made.
  businessDate DateTime    @map("business_date") @db.Date
  status       ShiftStatus @default(OPEN)
  openedAt     DateTime    @default(now()) @map("opened_at")
  closedAt     DateTime?   @map("closed_at")
  openedById   String      @map("opened_by_id")
  closedById   String?     @map("closed_by_id")

  /// What the cashier says the bank actually received, entered at close.
  declaredBankTotalSen Int? @map("declared_bank_total_sen")
  /// Net MONEY_IN revenue less MONEY_OUT refunds for this shift, computed
  /// server-side at close and updated when an offline record arrives late.
  systemNetSalesSen    Int? @map("system_net_sales_sen")
  /// declared − system. Positive is a surplus, negative a shortfall.
  varianceSen          Int? @map("variance_sen")

  reconciliationStatus ReconciliationStatus @default(NOT_REQUIRED) @map("reconciliation_status")

  business      Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  openedBy      User             @relation("ShiftsOpened", fields: [businessId, openedById], references: [businessId, id], onDelete: Restrict)
  closedBy      User?            @relation("ShiftsClosed", fields: [businessId, closedById], references: [businessId, id], onDelete: Restrict)
  orders        Order[]
  ledgerEntries LedgerEntry[]
  corrections   SaleCorrection[]

  @@unique([businessId, id])
  @@index([businessId, businessDate])
  @@index([businessId, status])
  @@map("shifts")
}

/// One row per business per trading day. The queue number resets daily and is
/// allocated by `UPDATE … RETURNING`, which takes the row lock itself — so
/// there is no read-then-increment gap for two terminals to fall into.
model QueueCounter {
  businessId   String   @map("business_id")
  businessDate DateTime @map("business_date") @db.Date
  currentVal   Int      @default(0) @map("current_val")
  updatedAt    DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@id([businessId, businessDate])
  @@map("queue_counters")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id           String   @id @default(uuid())
  businessId   String   @map("business_id")
  shiftId      String   @map("shift_id")
  businessDate DateTime @map("business_date") @db.Date

  /// `#042`. Unique within a business and business date.
  queueNumber  String  @map("queue_number")
  /// The `#OFF-01` the kitchen was actually told, when this sale was rung up
  /// offline. Kept after syncing: it is the only way to trace a disputed order
  /// back to what the customer was called.
  offlineLabel String? @map("offline_label")

  /// Minted on the device once per checkout and reused across every retry.
  /// The unique constraint is what makes replaying an offline sale safe.
  clientTxnId String      @unique @map("client_txn_id")
  origin      OrderOrigin @default(ONLINE)

  /// Server-recomputed. grossSen − orderDiscountSen − sum(line discounts) = totalAmountSen.
  grossSen         Int @map("gross_sen")
  lineDiscountSen  Int @default(0) @map("line_discount_sen")
  orderDiscountSen Int @default(0) @map("order_discount_sen")
  /// What the customer actually paid. For an offline sale this is the figure the
  /// device charged, which is the money that moved; it is never overwritten with
  /// a later menu price.
  totalAmountSen   Int @map("total_amount_sen")
  /// What the same basket comes to at the catalogue prices in force when the
  /// sale reached the server. Equal to `totalAmountSen` except for an offline
  /// sale priced against a menu that has since moved — the divergence is kept so
  /// it can be reported on rather than silently trusted or silently discarded.
  menuPriceSen     Int @map("menu_price_sen")

  paymentStatus OrderPaymentStatus @default(MANUALLY_CONFIRMED) @map("payment_status")
  paymentMode   String             @default("DUITNOW_QR") @map("payment_mode")

  /// Manual confirmation is the only control on revenue — there is no payment
  /// gateway — so who did it and when is recorded, once, and never edited.
  confirmedById String   @map("confirmed_by_id")
  confirmedAt   DateTime @map("confirmed_at")

  /// Raised by the cashier for the owner to resolve.
  flagStatus FlagStatus @default(NONE) @map("flag_status")
  flagReason String?    @map("flag_reason")

  /// Raised by the server, not the cashier — e.g. an offline sale whose price
  /// no longer matches the catalogue. Accepted, never silently repriced.
  needsReview  Boolean @default(false) @map("needs_review")
  reviewReason String? @map("review_reason")

  /// Set once the containing month has been closed and settled.
  isLocked Boolean @default(false) @map("is_locked")

  completedAt DateTime @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  shift         Shift            @relation(fields: [businessId, shiftId], references: [businessId, id], onDelete: Restrict)
  confirmedBy   User             @relation("OrdersConfirmed", fields: [businessId, confirmedById], references: [businessId, id], onDelete: Restrict)
  items         OrderItem[]
  ledgerEntries LedgerEntry[]
  corrections   SaleCorrection[]

  @@unique([businessId, id])
  @@unique([businessId, businessDate, queueNumber])
  @@index([shiftId])
  @@index([businessId, businessDate])
  @@index([needsReview])
  @@map("orders")
}

// ---------------------------------------------------------------------------
// Paid-sale corrections
// ---------------------------------------------------------------------------

/// Append-only counter correction. The paid order remains untouched; this row
/// and its brand deltas describe the value that moved afterwards.
model SaleCorrection {
  id                         String         @id @default(uuid())
  businessId                 String         @map("business_id")
  clientTxnId                String         @unique @map("client_txn_id")
  originalOrderId            String         @map("original_order_id")
  shiftId                    String         @map("shift_id")
  businessDate               DateTime       @map("business_date") @db.Date
  kind                       CorrectionKind
  reason                     String
  /// Signed: negative is money returned; positive is additional money received.
  deltaSen                   Int            @map("delta_sen")
  /// Full server-resolved ticket after an exchange. Null for a cancellation.
  replacementItems           Json?          @map("replacement_items")
  replacementCartDiscountSen Int?           @map("replacement_cart_discount_sen")
  replacementTotalSen        Int?           @map("replacement_total_sen")
  replacementMenuPriceSen    Int?           @map("replacement_menu_price_sen")
  createdById                String         @map("created_by_id")
  createdAt                  DateTime       @default(now()) @map("created_at")

  originalOrder Order                  @relation(fields: [businessId, originalOrderId], references: [businessId, id], onDelete: Restrict)
  shift         Shift                  @relation(fields: [businessId, shiftId], references: [businessId, id], onDelete: Restrict)
  createdBy     User                   @relation("CorrectionsCreated", fields: [businessId, createdById], references: [businessId, id], onDelete: Restrict)
  brandDeltas   CorrectionBrandDelta[]
  ledgerEntries LedgerEntry[]

  @@unique([businessId, id])
  @@index([originalOrderId, createdAt])
  @@index([shiftId])
  @@index([businessId, businessDate])
  @@map("sale_corrections")
}

/// Signed per-brand component of a correction. Kept as rows because settlement
/// and the ledger both report by brand, and JSON would make those sums fragile.
model CorrectionBrandDelta {
  id           BigInt @id @default(autoincrement())
  businessId   String @map("business_id")
  correctionId String @map("correction_id")
  brandId      String @map("brand_id")
  deltaSen     Int    @map("delta_sen")

  correction SaleCorrection @relation(fields: [businessId, correctionId], references: [businessId, id], onDelete: Cascade)
  brand      Brand          @relation(fields: [businessId, brandId], references: [businessId, id], onDelete: Restrict)

  @@unique([correctionId, brandId])
  @@index([brandId])
  @@map("correction_brand_deltas")
}

model OrderItem {
  id         String @id @default(uuid())
  businessId String @map("business_id")
  orderId    String @map("order_id")

  /// Restrict, not Cascade: a product that has ever been sold cannot be deleted,
  /// only deactivated. Historical lines must keep pointing somewhere real.
  productId  String @map("product_id")
  brandId    String @map("brand_id")
  categoryId String @map("category_id")

  /// Snapshot of the name as printed, in case the product is later renamed.
  productName String @map("product_name")

  quantity         Int @default(1)
  unitPriceSen     Int @map("unit_price_sen")
  modifierTotalSen Int @default(0) @map("modifier_total_sen")

  /// A discount applied to this line specifically.
  lineDiscountSen           Int @default(0) @map("line_discount_sen")
  /// This line's share of the order-wide discount, apportioned server-side by
  /// largest remainder. Stored rather than recomputed at report time, so
  /// per-brand net sales is a plain SUM and can never drift.
  allocatedOrderDiscountSen Int @default(0) @map("allocated_order_discount_sen")

  order     Order               @relation(fields: [businessId, orderId], references: [businessId, id], onDelete: Cascade)
  product   Product             @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)
  brand     Brand               @relation(fields: [businessId, brandId], references: [businessId, id], onDelete: Restrict)
  category  Category            @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict)
  modifiers OrderItemModifier[]

  @@unique([businessId, id])
  @@index([orderId])
  @@index([brandId])
  @@map("order_items")
}

/// Rows, not a JSON blob: add-on revenue by brand is a real report, and a blob
/// makes it a scan-and-parse.
model OrderItemModifier {
  id          String @id @default(uuid())
  businessId  String @map("business_id")
  orderItemId String @map("order_item_id")

  /// Nullable so a modifier deleted from the catalogue does not orphan the
  /// historical line. The snapshotted name and price stand on their own.
  ///
  /// The one relation here that is NOT composite: deleting the modifier nulls
  /// this column, and a composite key would null `business_id` with it. Checkout
  /// only ever resolves modifiers through the business-scoped client.
  modifierItemId String? @map("modifier_item_id")

  name     String
  priceSen Int          @default(0) @map("price_sen")
  type     ModifierType @default(ADD_ON)

  orderItem    OrderItem     @relation(fields: [businessId, orderItemId], references: [businessId, id], onDelete: Cascade)
  modifierItem ModifierItem? @relation(fields: [modifierItemId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

// ---------------------------------------------------------------------------
// Ledger
// ---------------------------------------------------------------------------

/// Append-only. Money is never corrected by editing an entry — a correction is
/// its own reversing entry, so the history stays auditable.
///
/// The running balance is computed, never stored, and must be ordered by
/// (businessDate, id) rather than id alone: entries get backdated, and ordering
/// by insertion would put a receipt entered on the 8th for the 3rd at the
/// bottom of the book with a meaningless balance beside it.
model LedgerEntry {
  id           BigInt   @id @default(autoincrement())
  businessId   String   @map("business_id")
  businessDate DateTime @map("business_date") @db.Date
  entryAt      DateTime @default(now()) @map("entry_at")

  direction   LedgerDirection
  amountSen   Int             @map("amount_sen")
  category    LedgerCategory
  description String

  /// Null means the entry is shared across brands rather than belonging to one.
  brandId String? @map("brand_id")

  orderId      String? @map("order_id")
  /// Set on entries produced by resolving a shift's unreconciled variance, so
  /// the owner can trace any adjustment back to the close that caused it.
  shiftId      String? @map("shift_id")
  correctionId String? @map("correction_id")

  createdAt DateTime @default(now()) @map("created_at")

  business   Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  brand      Brand?          @relation(fields: [businessId, brandId], references: [businessId, id], onDelete: Restrict)
  order      Order?          @relation(fields: [businessId, orderId], references: [businessId, id], onDelete: Restrict)
  shift      Shift?          @relation(fields: [businessId, shiftId], references: [businessId, id], onDelete: Restrict)
  correction SaleCorrection? @relation(fields: [businessId, correctionId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, businessDate, id])
  @@index([orderId])
  @@index([shiftId])
  @@index([correctionId])
  @@map("ledger_entries")
}

// ---------------------------------------------------------------------------
// Account
// ---------------------------------------------------------------------------

/// A business's profile and partner split. One row per business.
///
/// The percentages are read at the moment they are used — each expense
/// snapshots its own split when it is logged — so changing them here never
/// rewrites a past period.
model AccountSettings {
  businessId            String   @id @map("business_id")
  businessName          String   @map("business_name")
  outletName            String   @map("outlet_name")
  /// Partner settlement: two brands, each owned by a partner, with a monthly
  /// payout between them. Off for a new business; a solo shop never sees it.
  settlementEnabled     Boolean  @default(false) @map("settlement_enabled")
  /// When one trading day ends and the next begins, 0–12 (hour of the morning,
  /// Malaysia time). A 1am sale with the default 5 counts for the night before.
  dayRolloverHour       Int      @default(5) @map("day_rollover_hour")
  /// Share of shared overheads borne by Food, 0–100. Drinks takes the rest.
  sharedOverheadFoodPct Int      @map("shared_overhead_food_pct")
  /// The host's cut of the Food net result, 0–100.
  hostCommissionPct     Int      @map("host_commission_pct")
  /// Food's share of shared equipment, 0–100. Separate from the overhead split.
  capitalAssetFoodPct   Int      @map("capital_asset_food_pct")
  updatedAt             DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@map("account_settings")
}

// ---------------------------------------------------------------------------
// Owner books — expenses, settled periods, and the counter's heartbeat
// ---------------------------------------------------------------------------

enum ExpenseCategory {
  RAW_MATERIALS
  PACKAGING
  RENT
  UTILITIES
  OPERATIONS
  MAINTENANCE
  CAPITAL_ASSET
  /// Ice deliveries and gas tong refills: bought constantly, worth their own line.
  ICE_GAS
  /// Staff pay, written by paying a payslip (Team → Payroll), never typed in.
  WAGES
}

/// How the money left, as printed or remembered. Informational: who paid
/// (`PaymentSource`) is what moves the ledger.
enum PaymentMethod {
  CASH
  DUITNOW_QR
  DEBIT_CARD
  BANK_TRANSFER
}

/// Who actually paid. A partner paying out of pocket creates a debt to them,
/// not an outflow from the stall — nothing reaches the ledger until the stall
/// reimburses them.
enum PaymentSource {
  STALL_FUNDS
  PARTNER_FOOD
  PARTNER_DRINKS
}

/// A cost the stall incurred.
///
/// The food/drinks split is a SNAPSHOT taken when the expense is logged, so a
/// later change to the overhead ratio can never rewrite a past period. CHECK
/// constraints in the migration make the two shares always sum to the amount.
/// With settlement off, the whole amount sits on the "food" side: the split is
/// only ever read by settlement.
model Expense {
  id              String          @id @default(uuid())
  businessId      String          @map("business_id")
  businessDate    DateTime        @map("business_date") @db.Date
  amountSen       Int             @map("amount_sen")
  category        ExpenseCategory
  paidBy          PaymentSource   @map("paid_by")
  /// Null means shared between brands, apportioned by the split below.
  brandId         String?         @map("brand_id")
  foodSplitPct    Int             @map("food_split_pct")
  foodAmountSen   Int             @map("food_amount_sen")
  drinksAmountSen Int             @map("drinks_amount_sen")
  description     String
  receiptUrl      String?         @map("receipt_url")
  /// The supplier's own invoice or receipt number, for matching a dispute.
  receiptNo       String?         @map("receipt_no")
  vendor          String?
  /// Time printed on the receipt, "HH:MM". The day is `businessDate`.
  receiptTime     String?         @map("receipt_time")
  paymentMethod   PaymentMethod?  @map("payment_method")
  /// The owner's own remark for whoever audits this later.
  notes           String?
  /// For a partner-paid expense: has the stall reimbursed them yet?
  isSettled       Boolean         @default(false) @map("is_settled")
  /// Set once the containing period has been closed and settled.
  isLocked        Boolean         @default(false) @map("is_locked")
  createdById     String          @map("created_by_id")
  createdAt       DateTime        @default(now()) @map("created_at")

  brand     Brand?        @relation(fields: [businessId, brandId], references: [businessId, id], onDelete: Restrict)
  createdBy User          @relation("ExpensesCreated", fields: [businessId, createdById], references: [businessId, id], onDelete: Restrict)
  items     ExpenseItem[]
  /// Set when this expense is a paid payslip's wages.
  payslip   Payslip?

  @@unique([businessId, id])
  @@index([businessId, businessDate])
  @@index([paidBy, isSettled])
  @@map("expenses")
}

/// One line of an itemised receipt. When an expense has lines, they sum
/// exactly to its `amountSen` — the API refuses anything else.
model ExpenseItem {
  id            String  @id @default(uuid())
  businessId    String  @map("business_id")
  expenseId     String  @map("expense_id")
  name          String
  /// Thousandths of a unit, so 2.5 kg is 2500 and the money stays integer.
  quantityMilli Int     @map("quantity_milli")
  unit          String?
  /// May be negative: a discount or the 5-sen rounding line.
  unitPriceSen  Int     @map("unit_price_sen")
  /// quantity × unit price, rounded half away from zero to the sen.
  totalSen      Int     @map("total_sen")
  sortOrder     Int     @default(0) @map("sort_order")

  expense Expense @relation(fields: [businessId, expenseId], references: [businessId, id], onDelete: Cascade)

  @@index([expenseId])
  @@map("expense_items")
}

/// A settled period, frozen at the figures both partners were paid against.
///
/// Never recomputed. The next period's opening deficit is read from here, so
/// a locked month stays exactly as agreed. An exclusion constraint in the
/// migration makes two settled periods of one business overlapping impossible.
model PeriodClosure {
  id                    String   @id @default(uuid())
  businessId            String   @map("business_id")
  startDate             DateTime @map("start_date") @db.Date
  endDate               DateTime @map("end_date") @db.Date
  closedAt              DateTime @default(now()) @map("closed_at")
  closedById            String   @map("closed_by_id")
  foodNetSalesSen       Int      @map("food_net_sales_sen")
  foodDirectExpensesSen Int      @map("food_direct_expenses_sen")
  foodOverheadShareSen  Int      @map("food_overhead_share_sen")
  foodNetResultSen      Int      @map("food_net_result_sen")
  openingIouSen         Int      @map("opening_iou_sen")
  hostCommissionSen     Int      @map("host_commission_sen")
  closingIouSen         Int      @map("closing_iou_sen")
  foodPayoutSen         Int      @map("food_payout_sen")
  drinksPayoutSen       Int      @map("drinks_payout_sen")

  closedBy User @relation("PeriodsClosed", fields: [businessId, closedById], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, endDate])
  @@map("period_closures")
}

/// What the owner can know about their counter tablet. One row per business.
///
/// Written only by the tablet's heartbeat. The server cannot see a tablet that
/// has stopped calling, so silence is the only offline signal there is.
model TerminalStatus {
  businessId              String    @id @map("business_id")
  lastSeenAt              DateTime? @map("last_seen_at")
  /// Flush attempts in a row that failed to send something, as the tablet reports.
  consecutiveSyncFailures Int       @default(0) @map("consecutive_sync_failures")
  lastSeenById            String?   @map("last_seen_by_id")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@map("terminal_status")
}

// ---------------------------------------------------------------------------
// Sessions and partners
// ---------------------------------------------------------------------------

/// What a session may reach. One account signs in to both apps; the scope is
/// decided by which app signed in.
enum SessionScope {
  /// The counter tablet: sales, corrections, shifts. Never expires — the
  /// cashier only ever has the PIN — and is revoked from the RMS instead.
  COUNTER
  /// The owner dashboard: everything, including the books. Expires.
  OWNER
  /// vistahub.my, between signing in and picking an app. Can do exactly one
  /// thing — mint a handoff code — and lasts minutes.
  HUB
  /// One staff member on team.vistahub.my: their own roster, applications,
  /// attendance and pay. Refused by every /rms route and every counter route.
  STAFF
}

/// One signed-in device. Every request checks its row, which is how signing
/// the counter out from the RMS takes effect on the tablet's very next request.
/// The business a request acts for is read from here, never from the request.
model Session {
  id         String       @id @default(uuid())
  businessId String       @map("business_id")
  userId     String       @map("user_id")
  scope      SessionScope
  createdAt  DateTime     @default(now()) @map("created_at")
  lastUsedAt DateTime     @default(now()) @map("last_used_at")
  revokedAt  DateTime?    @map("revoked_at")
  /// The staff member a STAFF session belongs to; `userId` is then the business
  /// account they signed in under. Null for every other scope.
  staffId    String?      @map("staff_id")

  user  User         @relation(fields: [businessId, userId], references: [businessId, id], onDelete: Cascade)
  staff StaffMember? @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, scope, revokedAt])
  @@index([staffId])
  @@map("sessions")
}

/// A one-time pass from vistahub.my to the POS or RMS. Each app keeps its own
/// sign-in on its own domain, so the hub cannot hand over a token directly; it
/// hands over this instead, which the app swaps for a session of its own.
///
/// Only the SHA-256 of the code is stored. It lives a minute and works once.
model HandoffCode {
  id         String       @id @default(uuid())
  businessId String       @map("business_id")
  userId     String       @map("user_id")
  codeHash   String       @unique @map("code_hash")
  /// COUNTER for the POS, OWNER for the RMS.
  target     SessionScope
  expiresAt  DateTime     @map("expires_at")
  usedAt     DateTime?    @map("used_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [businessId, userId], references: [businessId, id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("handoff_codes")
}

enum PartnerRole {
  FOOD_OWNER
  /// Hosts the stall and owns Drinks. Takes the host commission on Food.
  STALL_HOST
}

/// A partner in the business — a name settlement pays, one per brand. Not a
/// login: the business has one account.
model Partner {
  id         String      @id @default(uuid())
  businessId String      @map("business_id")
  name       String
  brandId    String      @map("brand_id")
  role       PartnerRole

  brand Brand @relation(fields: [businessId, brandId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, brandId])
  @@unique([businessId, role])
  @@map("partners")
}

// ---------------------------------------------------------------------------
// Guessing limits
// ---------------------------------------------------------------------------

/// Wrong-password and wrong-PIN attempts, one row per client per route. In the
/// database rather than memory because the API runs as serverless functions that
/// share no memory and are recycled at will (src/attempts.ts). A row is useless
/// once `resetAt` passes and is cleared on the next attempt.
model AttemptCounter {
  /// `<method> <route> <client address>`.
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(3)

  @@index([resetAt])
  @@map("attempt_counters")
}

// ---------------------------------------------------------------------------
// Team — staff, rostering, attendance and payroll (TEAM-MODULE-PLAN.md)
//
// Three layers, kept apart on purpose:
//  * the roster is what was PLANNED (roster weeks, slots, assignments);
//  * attendance is what HAPPENED (clock in / out, approved by management);
//  * payroll pays APPROVED attendance, never the roster.
// A paid payslip is a snapshot and is never rewritten: a later change to the
// attendance behind it becomes a payroll adjustment instead.
// ---------------------------------------------------------------------------

enum StaffStatus {
  ACTIVE
  /// Cannot sign in and is left out of rostering. History stays.
  INACTIVE
}

enum StaffCredentialKind {
  PIN
}

enum SoloSuitability {
  SUITABLE
  CAUTION
  NOT_RECOMMENDED
}

enum TrainingStatus {
  TRAINEE
  TRAINED
}

enum RosterStatus {
  DRAFT
  APPLICATIONS_OPEN
  APPLICATIONS_CLOSED
  /// The engine has suggested a roster; nothing is visible to staff yet.
  GENERATED
  IN_REVIEW
  /// Staff see their shifts. Active and Completed are derived from the dates.
  PUBLISHED
}

enum ApplicationStatus {
  APPLIED
  WITHDRAWN
}

enum AssignmentStatus {
  ACTIVE
  /// The staff member pulled out themselves, before the deadline.
  WITHDRAWN
  /// Management took them off.
  REMOVED
}

enum AssignmentSource {
  AUTO
  MANUAL
  REPLACEMENT
}

enum CoverageStatus {
  OPEN
  FILLED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  /// Management confirmed it on the staff member's behalf (WhatsApp, a call…).
  MANAGER_CONFIRMED
  MANAGER_SKIPPED
  /// The vacancy was filled or cancelled while this offer was waiting.
  SUPERSEDED
}

enum AttendanceSource {
  TEAM_APP
  MANUAL
}

enum AttendanceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayslipStatus {
  APPROVED
  PAID
}

enum PayslipLineKind {
  ATTENDANCE
  ADJUSTMENT
}

enum AdjustmentStatus {
  OPEN
  INCLUDED
  DISMISSED
}

enum PayFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM
}

enum RoundingMode {
  FLOOR
  NEAREST
}

/// A person who works shifts. Not a User: staff never hold the business
/// account's email or password, only a PIN (see StaffCredential).
model StaffMember {
  id                String      @id @default(uuid())
  businessId        String      @map("business_id")
  name              String
  /// The business's own staff number, e.g. "S012". Unique within the business.
  staffCode         String      @map("staff_code")
  status            StaffStatus @default(ACTIVE)
  defaultWorkTypeId String?     @map("default_work_type_id")
  /// What they can do, e.g. barista, kitchen. Matched against a slot's needs.
  roleTags          String[]    @default([]) @map("role_tags")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  business        Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  defaultWorkType WorkType?           @relation("DefaultWorkType", fields: [businessId, defaultWorkTypeId], references: [businessId, id], onDelete: Restrict)
  credentials     StaffCredential[]
  attributes      StaffAttributes?
  sessions        Session[]
  applications    ShiftApplication[]
  assignments     Assignment[]
  offers          ReplacementOffer[]
  attendance      AttendanceRecord[]
  payslips        Payslip[]
  adjustments     PayrollAdjustment[]

  @@unique([businessId, id])
  @@unique([businessId, staffCode])
  @@index([businessId, status])
  @@map("staff_members")
}

/// How a staff member proves who they are. Only hashes are stored. A separate
/// table so a stronger method can be added beside the PIN later.
model StaffCredential {
  id           String              @id @default(uuid())
  businessId   String              @map("business_id")
  staffId      String              @map("staff_id")
  kind         StaffCredentialKind
  secretHash   String              @map("secret_hash")
  /// The same PIN, AES-GCM encrypted with a server-held key (src/team/seal.ts),
  /// so management can look it up in the RMS. Never used to sign in. Null for
  /// PINs set before this existed.
  secretSealed String?             @map("secret_sealed")
  setAt        DateTime            @default(now()) @map("set_at")

  staff StaffMember @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)

  @@unique([staffId, kind])
  @@map("staff_credentials")
}

/// CONFIDENTIAL. Management's read of a staff member, used by the rostering
/// engine. Its own table so that no staff-facing query can select it by
/// accident; no /team route reads it at all.
model StaffAttributes {
  staffId            String          @id @map("staff_id")
  businessId         String          @map("business_id")
  /// 1–5, null for "not assessed".
  reliability        Int?
  capability         Int?
  experience         Int?
  soloSuitability    SoloSuitability @default(SUITABLE) @map("solo_suitability")
  trainingStatus     TrainingStatus  @default(TRAINED) @map("training_status")
  /// −2 … +2. A thumb on the scale, not a rule.
  managementPriority Int             @default(0) @map("management_priority")
  notes              String?
  /// Future attributes, by name.
  extra              Json            @default("{}")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  staff StaffMember @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)

  @@unique([businessId, staffId])
  @@map("staff_attributes")
}

/// A kind of work with its own hourly rate: Regular RM 7, Training RM 5, …
model WorkType {
  id             String   @id @default(uuid())
  businessId     String   @map("business_id")
  name           String
  rateSenPerHour Int      @map("rate_sen_per_hour")
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  defaultFor  StaffMember[]      @relation("DefaultWorkType")
  slots       ShiftSlot[]
  templates   SlotTemplate[]
  assignments Assignment[]
  attendance  AttendanceRecord[]

  @@unique([businessId, id])
  @@unique([businessId, name])
  @@map("work_types")
}

/// A business's rostering and payroll rules. Every number the brief says must
/// not be hardcoded lives here. A roster week copies what it needs when it is
/// created, so changing these never rewrites a week already under way.
model TeamSettings {
  businessId              String       @id @map("business_id")
  /// Shifts one staff member may apply for in a week.
  applicationLimit        Int          @default(10) @map("application_limit")
  /// The normal number of shifts ASSIGNED per staff member per week, and the caps.
  assignmentTargetShifts  Int          @default(5) @map("assignment_target_shifts")
  assignmentMaxShifts     Int          @default(7) @map("assignment_max_shifts")
  assignmentMaxMinutes    Int          @default(2700) @map("assignment_max_minutes")
  /// Staff may pull out of a shift until this many hours before it starts.
  withdrawalDeadlineHours Int          @default(24) @map("withdrawal_deadline_hours")
  /// A vacancy this close to its start is urgent coverage.
  urgentCoverageHours     Int          @default(24) @map("urgent_coverage_hours")
  /// Payable time is rounded to this many minutes (1 = exact).
  payRoundingMinutes      Int          @default(30) @map("pay_rounding_minutes")
  payRoundingMode         RoundingMode @default(FLOOR) @map("pay_rounding_mode")
  payFrequency            PayFrequency @default(WEEKLY) @map("pay_frequency")
  /// A day the pay cycle starts on, from which every period is counted.
  payAnchorDate           DateTime     @default(dbgenerated("'2026-01-05'::date")) @map("pay_anchor_date") @db.Date
  /// Payday is this many days after the period ends.
  paydayOffsetDays        Int          @default(3) @map("payday_offset_days")
  /// The rostering engine's weights, by name. See src/domain/rostering.ts.
  engineWeights           Json         @default("{}") @map("engine_weights")
  /// Optional short code staff can type instead of the business email.
  orgCode                 String?      @unique @map("org_code")
  updatedAt               DateTime     @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@map("team_settings")
}

/// Normal opening hours, per weekday (0 = Monday … 6 = Sunday).
model OperatingHours {
  id         String  @id @default(uuid())
  businessId String  @map("business_id")
  weekday    Int
  isClosed   Boolean @default(false) @map("is_closed")
  /// "HH:MM". Closing at or before opening means after midnight.
  opensAt    String  @map("opens_at")
  closesAt   String  @map("closes_at")

  @@unique([businessId, weekday])
  @@map("operating_hours")
}

/// Days the business is shut: a holiday, a renovation.
model ClosedPeriod {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  startDate  DateTime @map("start_date") @db.Date
  endDate    DateTime @map("end_date") @db.Date
  reason     String?

  @@index([businessId, startDate])
  @@map("closed_periods")
}

/// The usual week's shifts. A new roster week is stamped out from these and
/// then edited freely.
model SlotTemplate {
  id            String   @id @default(uuid())
  businessId    String   @map("business_id")
  weekday       Int
  /// "HH:MM". An end at or before the start means the shift runs past midnight.
  startTime     String   @map("start_time")
  endTime       String   @map("end_time")
  requiredStaff Int      @default(1) @map("required_staff")
  canRunSolo    Boolean  @default(true) @map("can_run_solo")
  roleTags      String[] @default([]) @map("role_tags")
  workTypeId    String?  @map("work_type_id")
  label         String?

  workType WorkType? @relation(fields: [businessId, workTypeId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, weekday])
  @@map("slot_templates")
}

/// One Monday-to-Sunday roster and everything about its application round.
model RosterWeek {
  id                      String       @id @default(uuid())
  businessId              String       @map("business_id")
  /// The Monday.
  weekStart               DateTime     @map("week_start") @db.Date
  status                  RosterStatus @default(DRAFT)
  applicationsOpenAt      DateTime?    @map("applications_open_at")
  applicationsCloseAt     DateTime?    @map("applications_close_at")
  reviewDeadline          DateTime?    @map("review_deadline")
  publishDeadline         DateTime?    @map("publish_deadline")
  // Copied from TeamSettings when the week is created, editable per week.
  applicationLimit        Int          @map("application_limit")
  assignmentTargetShifts  Int          @map("assignment_target_shifts")
  assignmentMaxShifts     Int          @map("assignment_max_shifts")
  assignmentMaxMinutes    Int          @map("assignment_max_minutes")
  withdrawalDeadlineHours Int          @map("withdrawal_deadline_hours")
  generatedAt             DateTime?    @map("generated_at")
  reviewedAt              DateTime?    @map("reviewed_at")
  publishedAt             DateTime?    @map("published_at")
  /// Bumped on every change to the week's slots or assignments.
  version                 Int          @default(1)
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")

  business Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  slots    ShiftSlot[]

  @@unique([businessId, id])
  @@unique([businessId, weekStart])
  @@map("roster_weeks")
}

/// One shift to be staffed. Times are real timestamps, so 16:30–21:00 is
/// simply 4.5 hours and nothing assumes whole hours.
model ShiftSlot {
  id            String   @id @default(uuid())
  businessId    String   @map("business_id")
  rosterWeekId  String   @map("roster_week_id")
  startsAt      DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime @map("ends_at") @db.Timestamptz(3)
  requiredStaff Int      @default(1) @map("required_staff")
  canRunSolo    Boolean  @default(true) @map("can_run_solo")
  roleTags      String[] @default([]) @map("role_tags")
  workTypeId    String?  @map("work_type_id")
  label         String?
  /// Extra people may be added beyond requiredStaff, as backup.
  allowsBackup  Boolean  @default(false) @map("allows_backup")

  rosterWeek   RosterWeek         @relation(fields: [businessId, rosterWeekId], references: [businessId, id], onDelete: Cascade)
  workType     WorkType?          @relation(fields: [businessId, workTypeId], references: [businessId, id], onDelete: Restrict)
  applications ShiftApplication[]
  assignments  Assignment[]
  coverage     CoverageRequest[]

  @@unique([businessId, id])
  @@index([rosterWeekId, startsAt])
  @@map("shift_slots")
}

/// "I am willing to work this shift." Never a promise of being given it.
model ShiftApplication {
  id         String            @id @default(uuid())
  businessId String            @map("business_id")
  slotId     String            @map("slot_id")
  staffId    String            @map("staff_id")
  status     ApplicationStatus @default(APPLIED)
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  slot  ShiftSlot   @relation(fields: [businessId, slotId], references: [businessId, id], onDelete: Cascade)
  staff StaffMember @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Restrict)

  @@unique([slotId, staffId])
  @@index([staffId])
  @@map("shift_applications")
}

/// "This person works this shift." Visible to staff once the week is published.
model Assignment {
  id                 String           @id @default(uuid())
  businessId         String           @map("business_id")
  slotId             String           @map("slot_id")
  staffId            String           @map("staff_id")
  status             AssignmentStatus @default(ACTIVE)
  source             AssignmentSource
  /// Locked assignments are never moved by the engine.
  isLocked           Boolean          @default(false) @map("is_locked")
  /// Overrides the slot's and the staff member's work type for this shift.
  workTypeId         String?          @map("work_type_id")
  /// A one-off rate for this shift only. The work type's rate is untouched.
  rateOverrideSen    Int?             @map("rate_override_sen")
  rateOverrideReason String?          @map("rate_override_reason")
  rateOverrideAt     DateTime?        @map("rate_override_at")
  /// MANAGEMENT ONLY: why the engine chose this person.
  explanation        String?
  /// A backup: extra to the shift's places, never counted as filling one.
  isBackup           Boolean          @default(false) @map("is_backup")
  /// This person's own times on the shift, when not the slot's (backups).
  startsAt           DateTime?        @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime?        @map("ends_at") @db.Timestamptz(3)
  /// Shown as a number of hours rather than times.
  hoursOnly          Boolean          @default(false) @map("hours_only")
  endedAt            DateTime?        @map("ended_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  slot       ShiftSlot          @relation(fields: [businessId, slotId], references: [businessId, id], onDelete: Cascade)
  staff      StaffMember        @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Restrict)
  workType   WorkType?          @relation(fields: [businessId, workTypeId], references: [businessId, id], onDelete: Restrict)
  vacancies  CoverageRequest[]
  attendance AttendanceRecord[]

  @@unique([businessId, id])
  @@index([slotId, status])
  @@index([staffId, status])
  @@map("assignments")
}

/// A seat that came free on a published roster and needs someone.
model CoverageRequest {
  id                  String         @id @default(uuid())
  businessId          String         @map("business_id")
  slotId              String         @map("slot_id")
  vacatedAssignmentId String?        @map("vacated_assignment_id")
  isUrgent            Boolean        @default(false) @map("is_urgent")
  status              CoverageStatus @default(OPEN)
  createdAt           DateTime       @default(now()) @map("created_at")
  resolvedAt          DateTime?      @map("resolved_at")

  slot              ShiftSlot          @relation(fields: [businessId, slotId], references: [businessId, id], onDelete: Cascade)
  vacatedAssignment Assignment?        @relation(fields: [businessId, vacatedAssignmentId], references: [businessId, id], onDelete: Restrict)
  offers            ReplacementOffer[]

  @@unique([businessId, id])
  @@index([businessId, status])
  @@map("coverage_requests")
}

/// One offer of a vacancy to one staff member, made in queue order.
model ReplacementOffer {
  id                String      @id @default(uuid())
  businessId        String      @map("business_id")
  coverageRequestId String      @map("coverage_request_id")
  staffId           String      @map("staff_id")
  /// Position in the replacement queue, 1 first.
  rank              Int
  status            OfferStatus @default(PENDING)
  createdAt         DateTime    @default(now()) @map("created_at")
  respondedAt       DateTime?   @map("responded_at")

  coverageRequest CoverageRequest @relation(fields: [businessId, coverageRequestId], references: [businessId, id], onDelete: Cascade)
  staff           StaffMember     @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Restrict)

  @@unique([coverageRequestId, staffId])
  @@index([staffId, status])
  @@map("replacement_offers")
}

/// What actually happened. A clock-in is only a claim until management
/// approves the times; only approved time is ever paid.
model AttendanceRecord {
  id              String           @id @default(uuid())
  businessId      String           @map("business_id")
  staffId         String           @map("staff_id")
  /// The rostered shift this was for. Null for unrostered work.
  assignmentId    String?          @map("assignment_id")
  clockInAt       DateTime         @map("clock_in_at") @db.Timestamptz(3)
  clockOutAt      DateTime?        @map("clock_out_at") @db.Timestamptz(3)
  source          AttendanceSource
  status          AttendanceStatus @default(PENDING)
  /// The times management agreed to pay for. Default to the clocked times.
  approvedStartAt DateTime?        @map("approved_start_at") @db.Timestamptz(3)
  approvedEndAt   DateTime?        @map("approved_end_at") @db.Timestamptz(3)
  /// For unrostered work, or to override the shift's work type.
  workTypeId      String?          @map("work_type_id")
  note            String?
  /// Bumped on every edit, so a paid payslip can tell its snapshot is stale.
  version         Int              @default(1)
  approvedAt      DateTime?        @map("approved_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  staff       StaffMember         @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Restrict)
  assignment  Assignment?         @relation(fields: [businessId, assignmentId], references: [businessId, id], onDelete: Restrict)
  workType    WorkType?           @relation(fields: [businessId, workTypeId], references: [businessId, id], onDelete: Restrict)
  adjustments PayrollAdjustment[]

  @@unique([businessId, id])
  @@index([businessId, clockInAt])
  @@index([staffId, clockInAt])
  @@map("attendance_records")
}

/// One staff member's pay for one pay period. A draft is never stored — it is
/// worked out from approved attendance whenever it is viewed. Approving
/// snapshots the lines; paying freezes them for good.
model Payslip {
  id            String        @id @default(uuid())
  businessId    String        @map("business_id")
  staffId       String        @map("staff_id")
  periodStart   DateTime      @map("period_start") @db.Date
  periodEnd     DateTime      @map("period_end") @db.Date
  status        PayslipStatus @default(APPROVED)
  totalMinutes  Int           @map("total_minutes")
  totalSen      Int           @map("total_sen")
  approvedAt    DateTime      @default(now()) @map("approved_at")
  paidAt        DateTime?     @map("paid_at")
  /// The business date the payment was booked on.
  paidOn        DateTime?     @map("paid_on") @db.Date
  expenseId     String?       @unique @map("expense_id")
  ledgerEntryId BigInt?       @unique @map("ledger_entry_id")

  staff       StaffMember         @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Restrict)
  expense     Expense?            @relation(fields: [businessId, expenseId], references: [businessId, id], onDelete: Restrict)
  lines       PayslipLine[]
  adjustments PayrollAdjustment[] @relation("AdjustmentCause")
  included    PayrollAdjustment[] @relation("AdjustmentIncluded")

  @@unique([businessId, id])
  @@unique([businessId, expenseId])
  @@unique([businessId, staffId, periodStart, periodEnd])
  @@index([businessId, periodStart])
  @@map("payslips")
}

/// One snapshotted line of a payslip.
model PayslipLine {
  id                String          @id @default(uuid())
  businessId        String          @map("business_id")
  payslipId         String          @map("payslip_id")
  kind              PayslipLineKind
  attendanceId      String?         @map("attendance_id")
  /// The attendance version this line was priced from.
  attendanceVersion Int?            @map("attendance_version")
  adjustmentId      String?         @map("adjustment_id")
  workDate          DateTime        @map("work_date") @db.Date
  clockInAt         DateTime?       @map("clock_in_at") @db.Timestamptz(3)
  clockOutAt        DateTime?       @map("clock_out_at") @db.Timestamptz(3)
  minutes           Int
  workTypeName      String          @map("work_type_name")
  rateSenPerHour    Int             @map("rate_sen_per_hour")
  amountSen         Int             @map("amount_sen")
  description       String?
  sortOrder         Int             @default(0) @map("sort_order")

  payslip Payslip @relation(fields: [businessId, payslipId], references: [businessId, id], onDelete: Cascade)

  @@index([payslipId])
  @@index([attendanceId])
  @@map("payslip_lines")
}

/// Money a paid payslip got wrong, discovered later. Never folded silently
/// into the paid record; management includes it in a later payslip or
/// dismisses it.
model PayrollAdjustment {
  id                  String           @id @default(uuid())
  businessId          String           @map("business_id")
  staffId             String           @map("staff_id")
  attendanceId        String?          @map("attendance_id")
  causePayslipId      String?          @map("cause_payslip_id")
  /// Positive: more is owed to the staff member. Negative: they were overpaid.
  amountSen           Int              @map("amount_sen")
  minutesDelta        Int              @default(0) @map("minutes_delta")
  reason              String
  status              AdjustmentStatus @default(OPEN)
  includedInPayslipId String?          @map("included_in_payslip_id")
  resolvedNote        String?          @map("resolved_note")
  createdAt           DateTime         @default(now()) @map("created_at")
  resolvedAt          DateTime?        @map("resolved_at")

  staff      StaffMember       @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Restrict)
  attendance AttendanceRecord? @relation(fields: [businessId, attendanceId], references: [businessId, id], onDelete: Restrict)
  cause      Payslip?          @relation("AdjustmentCause", fields: [businessId, causePayslipId], references: [businessId, id], onDelete: Restrict)
  includedIn Payslip?          @relation("AdjustmentIncluded", fields: [businessId, includedInPayslipId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, status])
  @@index([staffId])
  @@map("payroll_adjustments")
}

/// Who did what in the Team module, and what it looked like before and after.
/// Insert-only. Management only.
model TeamAuditEntry {
  id         BigInt   @id @default(autoincrement())
  businessId String   @map("business_id")
  /// OWNER, MANAGER, STAFF or SYSTEM.
  actorKind  String   @map("actor_kind")
  actorId    String?  @map("actor_id")
  actorLabel String   @map("actor_label")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@index([businessId, entityType, entityId])
  @@map("team_audit_log")
}

// ---------------------------------------------------------------------------
// Closing stock — a quick estimate at the end of the day, not inventory
// ---------------------------------------------------------------------------

/// How full the open container is, by eye.
/// How full the open one is: 0%, 25%, 50%, 75% or 100%. MORE_THAN_HALF and
/// LESS_THAN_HALF are the old three-step scale, kept for counts sent before.
enum StockBalance {
  MORE_THAN_HALF
  HALF
  LESS_THAN_HALF
  EMPTY
  QUARTER
  THREE_QUARTERS
  FULL
}

/// One thing the counter checks at closing, as the owner set it up.
///
/// Brand is the real brand. Category and subcategory are the owner's own
/// labels ("Sauce Tubs", "Milk"): the store room is grouped differently from
/// the menu, so the menu's categories are not reused for it. Nothing here is
/// a quantity on hand; counts live on submissions.
model StockItem {
  id            String   @id @default(uuid())
  businessId    String   @map("business_id")
  brandId       String   @map("brand_id")
  category      String
  /// Null when the category needs no further split.
  subcategory   String?
  name          String
  /// What one is counted in: "packs", "trays", "tubs". Null means plain units.
  unitLabel     String?  @map("unit_label")
  trackUnopened Boolean  @default(true) @map("track_unopened")
  trackOpened   Boolean  @default(false) @map("track_opened")
  /// More than half / half / less than half of the open one.
  trackBalance  Boolean  @default(true) @map("track_balance")
  /// Off: kept for the record, no longer on the counter's list.
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [businessId, brandId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@index([businessId, isActive])
  @@map("stock_items")
}

/// One closing count, as submitted from the counter.
model StockCount {
  id            String   @id @default(uuid())
  businessId    String   @map("business_id")
  businessDate  DateTime @map("business_date") @db.Date
  submittedAt   DateTime @default(now()) @map("submitted_at")
  /// The outlet name when it was counted.
  branchName    String   @map("branch_name")
  /// The rostered staff member who counted, if one was picked. Not a foreign
  /// key: the count outlives the staff record, and the name below is the record.
  staffId       String?  @map("staff_id")
  staffName     String   @map("staff_name")
  submittedById String   @map("submitted_by_id")
  remarks       String?

  submittedBy User             @relation("StockCountsSubmitted", fields: [businessId, submittedById], references: [businessId, id], onDelete: Restrict)
  lines       StockCountLine[]

  @@unique([businessId, id])
  @@index([businessId, businessDate])
  @@map("stock_counts")
}

/// One item on a count, with the item's set-up copied in as it was that day.
/// Renaming, regrouping or removing an item later leaves old counts as they read.
model StockCountLine {
  id            String        @id @default(uuid())
  businessId    String        @map("business_id")
  countId       String        @map("count_id")
  /// The item it was counted from. Not a foreign key, for the same reason.
  stockItemId   String?       @map("stock_item_id")
  brandId       String?       @map("brand_id")
  brandName     String        @map("brand_name")
  category      String
  subcategory   String?
  name          String
  unitLabel     String?       @map("unit_label")
  trackUnopened Boolean       @map("track_unopened")
  trackOpened   Boolean       @map("track_opened")
  trackBalance  Boolean       @map("track_balance")
  /// Where it sat on the list, so the report reads in the same order.
  position      Int
  /// Thousandths, so 2.5 packs is 2500 — the same convention as receipt lines.
  unopenedMilli Int?          @map("unopened_milli")
  openedMilli   Int?          @map("opened_milli")
  balance       StockBalance?

  count StockCount @relation(fields: [businessId, countId], references: [businessId, id], onDelete: Cascade)

  @@index([countId])
  @@map("stock_count_lines")
}
