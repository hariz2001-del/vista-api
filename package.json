{
  "name": "api-vista",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "build": "tsc -b",
    "lint": "oxlint src prisma",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run build && npm run test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.6.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.79.0",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
