{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true,

    "noEmit": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    /* Vercel compiles each file to .js; this turns `./x.ts` imports into `./x.js`
       in that output, or the deployed function cannot find its own modules. */
    "rewriteRelativeImportExtensions": true,

    /* This service handles money. Every one of these stays on. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  "include": ["src", "prisma", "test"]
}
