# Production environment for /opt/vista/api/.env on the server.
# Every secret here is generated ON the server and never copied anywhere else:
#
#   openssl rand -hex 24     # for POSTGRES_PASSWORD
#   openssl rand -hex 48     # for JWT_SECRET
#
# The same database password appears twice: once for the container that runs
# Postgres, once in the URL the API connects with.

NODE_ENV=production
PORT=3000

POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
DATABASE_URL="postgresql://vista:REPLACE_WITH_GENERATED_PASSWORD@127.0.0.1:5432/vista?schema=public"

JWT_SECRET=REPLACE_WITH_GENERATED_SECRET

# Only these sites' pages may call the API from a browser.
CORS_ORIGINS=https://pos.vistahub.my,https://rms.vistahub.my
