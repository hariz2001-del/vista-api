# Production environment for the api-vista project on Vercel:
# Project → Settings → Environment Variables, scoped to Production.
# Nothing in this file is ever filled in and committed.
#
# Both database URLs come from Supabase → your project → Connect → ORMs → Prisma.
# Copy them exactly as shown (the host varies by project) and put in the database
# password you chose when you created the project.
#
#  * DATABASE_URL — the TRANSACTION pooler, port 6543. Every API query uses it.
#    `pgbouncer=true` is required: the pooler cannot hold prepared statements.
#    `connection_limit=5` lets one function copy run the dashboard's parallel
#    reads and a checkout side by side; the pooler, not Postgres, absorbs these.
#  * DIRECT_URL — the SESSION pooler, port 5432. Only Prisma Migrate uses it.

NODE_ENV=production

DATABASE_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Signs every session token. Generate one and paste it straight into Vercel:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET

# Only these sites' pages may call the API from a browser. Until the custom
# domains are attached, use the two *.vercel.app addresses Vercel gives the
# POS and RMS projects.
CORS_ORIGINS=https://pos.vistahub.my,https://rms.vistahub.my

# SEED_PASSWORD / SEED_PIN are NOT set on Vercel. The seed runs once, from your
# own machine — see deploy/README.md.
